{
  "name": "dsh-sessions",
  "version": "0.1.0",
  "description": "Session discovery, creation, message delivery, and slash commands for DeepSeek Harness",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ephemeral-AI-Lab/dsh-plugins.git",
    "directory": "sessions"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-tool"
      ],
      "platform": "web"
    }
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/ui/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "LICENSE",
    "README.md",
    "cordis.patch.yml",
    "SPEC.md",
    "ui.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && node node_modules/tsdown/dist/run.mjs",
    "build:client": "tsc -p tsconfig.client.json && node node_modules/tsdown/dist/run.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:client": "tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"import('node:fs').then(({rmSync}) => rmSync('lib', { recursive: true, force: true }))\""
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-agent-default-model": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-agent-presets": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-commands": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-tool": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-commands": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-session-persistence": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-session-query": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-workspace": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.5",
    "react": ">=18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-api-remotes": "link:../../deepseek-harness/packages/api/remotes",
    "@deepseek-ai/dsh-client-runtime": "link:../../deepseek-harness/packages/client/runtime",
    "@deepseek-ai/dsh-client-ui-commands": "link:../../deepseek-harness/packages/client/ui-commands",
    "@deepseek-ai/dsh-client-ui-conversation": "link:../../deepseek-harness/packages/client/ui-conversation",
    "@deepseek-ai/dsh-client-ui-primitives": "link:../../deepseek-harness/packages/client/ui-primitives",
    "@deepseek-ai/dsh-client-ui-slots": "link:../../deepseek-harness/packages/client/ui-slots",
    "@deepseek-ai/dsh-client-ui-tool": "link:../../deepseek-harness/packages/client/ui-tool",
    "@deepseek-ai/dsh-agent-default-model": "link:../../deepseek-harness/packages/core/agent-default-model",
    "@deepseek-ai/dsh-agent-presets": "link:../../deepseek-harness/packages/preset/agent-presets",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-workspace": "link:../../deepseek-harness/packages/workspace/workspace",
    "@tsdown/css": "0.22.14",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.1",
    "lightningcss": "^1.33.0",
    "react": "18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "packageManager": "pnpm@11.7.0"
}
