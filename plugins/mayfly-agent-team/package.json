{
  "name": "dsh-mayfly-agent-team",
  "version": "0.1.0",
  "description": "Optional Agent Team preset and native Mayfly terminal UI",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ephemeral-AI-Lab/dsh-plugins.git",
    "directory": "plugins/mayfly-agent-team"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./tui": {
      "types": "./lib/tui.d.ts",
      "default": "./lib/tui.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "LICENSE",
    "NOTICE",
    "README.md",
    "README.zh.md",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "preset:sync": "node scripts/sync-preset.mjs",
    "preset:check": "node scripts/sync-preset.mjs --check",
    "check": "pnpm run preset:check && pnpm run typecheck && pnpm run test:coverage && pnpm run build"
  },
  "dependencies": {
    "@deepseek-ai/dsh-experimental-agent-team": "0.1.7-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.1.7-rc.1",
    "@deepseek-ai/dsh-agent-preset-registry": "0.1.7-rc.1",
    "@deepseek-ai/dsh-commands": "0.1.7-rc.1",
    "@deepseek-ai/dsh-session": "0.1.7-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.1.7-rc.1",
    "@deepseek-ai/dsh-subagent": "0.1.7-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.7-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.1",
    "@ephemeral-ai/mayfly": "^0.1.0-alpha.6",
    "@ephemeral-ai/mayfly-ui": "^0.1.0-alpha.6",
    "@deepseek-ai/dsh-agent-default-model": "0.1.7-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "0.1.7-rc.1",
    "@deepseek-ai/dsh-scope": "0.1.7-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.1.7-rc.1",
    "@deepseek-ai/dsh-agent-preset-registry": "0.1.7-rc.1",
    "@deepseek-ai/dsh-commands": "0.1.7-rc.1",
    "@deepseek-ai/dsh-session": "0.1.7-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.1.7-rc.1",
    "@deepseek-ai/dsh-subagent": "0.1.7-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.7-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.1",
    "@ephemeral-ai/mayfly": "0.1.0-alpha.6",
    "@ephemeral-ai/mayfly-ui": "0.1.0-alpha.6",
    "@deepseek-ai/dsh-agent-loop": "0.1.7-rc.1",
