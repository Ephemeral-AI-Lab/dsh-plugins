    "@deepseek-ai/dsh-session-persistence-jsonl": "0.1.7-rc.1",
    "@deepseek-ai/dsh-subagent-spawn-in-process": "0.1.7-rc.1",
    "@deepseek-ai/dsh-subagent-fork-in-process": "0.1.7-rc.1",
    "@deepseek-ai/dsh-agent-preset": "0.1.7-rc.1",
