{
  "name": "dsh-herdr-plus",
  "version": "0.1.0",
  "description": "Report a pane's agent state (working/blocked/idle, labeled with the current tool), session reference and log path, and session display metadata (title, model, context-usage tokens, state labels) to Herdr via its pane socket — plus an optional `herdr` skill and `herdr_agent_*` orchestration tools for launching sibling dsh/Mayfly sessions. Works in any dsh profile — TUIs, web, headless.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ephemeral-AI-Lab/dsh-plugins.git",
    "directory": "plugins/dsh-herdr-plus"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "LICENSE",
    "README.md",
    "cordis.patch.yml",
    "SPEC.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"import('node:fs').then(({rmSync}) => rmSync('lib', { recursive: true, force: true }))\""
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/schemastery": ">=3.18.2",
    "@deepseek-ai/dsh-agent": ">=0.1.2-alpha.3",
    "@deepseek-ai/dsh-session": ">=0.1.2-alpha.3",
    "@deepseek-ai/dsh-session-persistence": ">=0.1.2-alpha.3",
    "@deepseek-ai/dsh-session-title": ">=0.1.2-alpha.3",
    "@deepseek-ai/dsh-skill": ">=0.1.2-alpha.3",
    "@deepseek-ai/dsh-tools": ">=0.1.2-alpha.3",
    "@deepseek-ai/dsh-user-approval": ">=0.1.2-alpha.3",
    "@deepseek-ai/dsh-user-questions": ">=0.1.2-alpha.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../../../deepseek-harness/vendor/cordis",
    "@deepseek-ai/schemastery": "link:../../../deepseek-harness/vendor/schemastery",
    "@deepseek-ai/dsh-agent": "link:../../../deepseek-harness/packages/core/agent",
    "@deepseek-ai/dsh-session": "link:../../../deepseek-harness/packages/core/session",
    "@deepseek-ai/dsh-session-persistence": "link:../../../deepseek-harness/packages/session/session-persistence",
    "@deepseek-ai/dsh-session-title": "link:../../../deepseek-harness/packages/session/session-title",
    "@deepseek-ai/dsh-skill": "link:../../../deepseek-harness/packages/skill/skill",
    "@deepseek-ai/dsh-tools": "link:../../../deepseek-harness/packages/core/tools",
    "@deepseek-ai/dsh-user-approval": "link:../../../deepseek-harness/packages/interaction/user-approval",
    "@deepseek-ai/dsh-user-questions": "link:../../../deepseek-harness/packages/interaction/user-questions",
    "@types/node": "^22.20.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "packageManager": "pnpm@11.7.0"
}
