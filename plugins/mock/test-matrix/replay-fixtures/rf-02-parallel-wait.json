{
  "type": "dsh-mock-script",
  "version": 1,
  "steps": [
    {
      "parallel": [
        { "tool": "ordered_tool", "args": { "label": "left", "delayMs": 20 } },
        { "tool": "ordered_tool", "args": { "label": "right", "delayMs": 10 } }
      ]
    },
    { "wait": 200 },
    { "tool": "probe_tool", "args": { "value": "after-parallel" } }
  ]
}
